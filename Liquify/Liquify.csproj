<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>pyrochild.effects.liquify</RootNamespace>
    <AssemblyName>Liquify</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>

    <Product>Liquify</Product>
    <AssemblyTitle>Liquify</AssemblyTitle>
    <Description>Paint.NET Plugin</Description>
    <Company>Zach Walker, a.k.a. pyrochild</Company>
    <Copyright>Copyright © 2010-2026 Zach Walker</Copyright>

    <!-- Build/Revision come from the build date. -->
    <VersionPrefix>5.1</VersionPrefix>
    <AssemblyVersion>$(VersionPrefix).$([System.DateTime]::Now.ToString(yyMM)).$([System.DateTime]::Now.ToString(ddHH))</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="PaintDotNet.Base">
      <HintPath>C:\Program Files\Paint.NET\PaintDotNet.Base.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PaintDotNet.Core">
      <HintPath>C:\Program Files\Paint.NET\PaintDotNet.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PaintDotNet.Data">
      <HintPath>C:\Program Files\Paint.NET\PaintDotNet.Data.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PaintDotNet.Effects">
      <HintPath>C:\Program Files\Paint.NET\PaintDotNet.Effects.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PaintDotNet.Effects.Core">
      <HintPath>C:\Program Files\Paint.NET\PaintDotNet.Effects.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PaintDotNet.Primitives">
      <HintPath>C:\Program Files\Paint.NET\PaintDotNet.Primitives.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PaintDotNet.ComponentModel">
      <HintPath>C:\Program Files\Paint.NET\PaintDotNet.ComponentModel.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PaintDotNet.ObjectModel">
      <HintPath>C:\Program Files\Paint.NET\PaintDotNet.ObjectModel.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PaintDotNet.Windows">
      <HintPath>C:\Program Files\Paint.NET\PaintDotNet.Windows.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="common\ColorDialog.resx">
      <DependentUpon>ColorDialog.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="common\ColorWheel.resx">
      <DependentUpon>ColorWheel.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="ConfigDialog.resx">
      <DependentUpon>ConfigDialog.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="images\icon.png" />
    <EmbeddedResource Include="images\bloat.png" />
    <EmbeddedResource Include="images\donate.png" />
    <EmbeddedResource Include="images\freeze.png" />
    <EmbeddedResource Include="images\gridlarge.png" />
    <EmbeddedResource Include="images\gridsmall.png" />
    <EmbeddedResource Include="images\pucker.png" />
    <EmbeddedResource Include="images\push.png" />
    <EmbeddedResource Include="images\redo.png" />
    <EmbeddedResource Include="images\save.png" />
    <EmbeddedResource Include="images\thaw.png" />
    <EmbeddedResource Include="images\twistleft.png" />
    <EmbeddedResource Include="images\twistright.png" />
    <EmbeddedResource Include="images\undo.png" />
    <EmbeddedResource Include="images\zoomin.png" />
    <EmbeddedResource Include="images\zoomout.png" />
    <EmbeddedResource Include="images\minus.png" />
    <EmbeddedResource Include="images\open.png" />
    <EmbeddedResource Include="images\plus.png" />
    <EmbeddedResource Include="images\reconstruct.png" />
    <EmbeddedResource Include="images\colorwheel.png" />
  </ItemGroup>



  <PropertyGroup>
    <LiquifyEffectsDir>$(USERPROFILE)\Documents\paint.net App Files\Effects\</LiquifyEffectsDir>
  </PropertyGroup>

  <Target Name="LiquifyCopyToEffectsFolder" AfterTargets="Build">
    <MakeDir Directories="$(LiquifyEffectsDir)" Condition="!Exists('$(LiquifyEffectsDir)')" ContinueOnError="WarnAndContinue" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(LiquifyEffectsDir)" ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
